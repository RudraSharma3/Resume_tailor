# Copy to .env for local runs. .env is git-ignored. On Render, set these in the dashboard instead.
ANTHROPIC_API_KEY=sk-ant-...

# --- Accounts (required when hosted; optional locally) ---
# Your login. Leave both empty when running `python run.py` on your own computer for no sign-in.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=at-least-12-characters

# --- Hosted storage ---
# Postgres connection string (e.g. a free Neon database). Empty = local SQLite file in ./data
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Optional ---
# AI_DAILY_LIMIT=40            # AI steps per day for each approved user (you, the admin, have no limit). 0 = unlimited
# ALLOW_SIGNUP=1               # 0 = hide "Request access"
# NOTIFY_WEBHOOK_URL=          # https://ntfy.sh/<your-secret-topic> or a Discord/Slack webhook: pings you on new requests
# RESUME_TAILOR_MODEL=claude-opus-5-5
# RESUME_TAILOR_TARGET_MIN=82
# RESUME_TAILOR_TARGET_MAX=85
